# SERS Cancer Screening — Web Application Image
#
# Build:
#   docker build -f infra/Dockerfile.api -t sers-app .
#
# Run:
#   docker run --rm -p 8000:8000 sers-app
#   Open http://localhost:8000

# ── Stage 1: Builder ──
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY pyproject.toml pyproject.toml
COPY src/ src/
RUN pip install --no-cache-dir "."
RUN pip install --no-cache-dir joblib fastapi uvicorn python-multipart


# ── Stage 2: Runtime ──
FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY src/ src/
COPY config/config.yaml config/config.yaml
COPY scripts/deployment/sers_predict.py scripts/deployment/sers_predict.py
COPY scripts/deployment/sers_webapp.py scripts/deployment/sers_webapp.py
COPY artifacts/usersnet/ artifacts/usersnet/
COPY artifacts/baselines/ artifacts/baselines/

RUN useradd -m -u 1000 sers && chown -R sers:sers /app
USER sers

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["python", "scripts/deployment/sers_webapp.py", "--host", "0.0.0.0", "--port", "8000"]
